APP_NAME=Gueass
APP_ENV=local
APP_KEY=
# Em produção: APP_ENV=production e APP_DEBUG=false (sem stack traces).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gueass_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Só ligue com HTTPS em production. Em HTTP local deve permanecer false.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Lista de proxies confiáveis (IPs), vazia por padrão. Nunca use "*".
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gueass.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Provedor de IA usado pelo pipeline de geração de prompts.
# "null" é offline e determinístico, sem chamadas de rede.
# "gemini" usa a API gratuita do Google e exige GEMINI_API_KEY; se a chamada
# falhar (cota, timeout, chave inválida), o pipeline degrada sozinho para "null".
AI_PROVIDER=null

# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin inicial: php artisan gueass:create-admin
# Também aceita --email / --password. Não commitar valores reais.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Somente local/testing. Em production o seeder NÃO cria esses usuários.
# Se vazias, o seeder gera senha aleatória e exibe uma única vez no terminal.
# DEMO_ADMIN_EMAIL=admin@email.com
# DEMO_ADMIN_PASSWORD=
# DEMO_USER_EMAIL=usuario@email.com
# DEMO_USER_PASSWORD=
# GEMINI_TIMEOUT=15
# GEMINI_TRIES=2
# GEMINI_MAX_PAYLOAD_BYTES=65536

# Retenção do histórico de prompts (dias). Usado por php artisan gueass:prune-prompts
PROMPT_RETENTION_DAYS=90
