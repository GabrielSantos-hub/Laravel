Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^(\.env(\..+)?|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml(\.dist)?|vite\.config\.js)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/|$) - [F,L]
    # O vhost aponta para a raiz do projeto. /storage/* precisa cair em
    # public/storage (atalho do storage:link); se não, a regra abaixo responde 403.
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]
    RewriteRule ^(storage|vendor|database|tests|docs|app|bootstrap|config|routes|resources|node_modules)(/|$) - [F,L]
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
