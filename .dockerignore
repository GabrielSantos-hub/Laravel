# Controle de versão e configuração de editores/IDEs
.git
.gitattributes
.github
.vscode
.idea
.fleet
.nova
.zed

# Variáveis de ambiente e segredos — NUNCA entram na imagem
.env
.env.*
auth.json
*.pem
*.p12
*.pfx
id_rsa
id_rsa.pub
credentials.json
storage/*.key

# Dependências: reinstaladas dentro da imagem (composer install / npm ci)
vendor
node_modules

# Assets de build: gerados pela etapa Node do Dockerfile, não os locais
public/build
public/hot
public/storage

# Banco de dados local de desenvolvimento (SQLite)
database/*.sqlite
database/*.sqlite-journal

# Logs, cache, sessões e views compiladas localmente — recriados no container
storage/logs
storage/logs/**
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/app/public/*
storage/app/private/*
storage/pail
bootstrap/cache/*.php

# Testes e ferramentas de qualidade (não necessários na imagem de produção)
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
.editorconfig
.styleci.yml

# Metadados do próprio Docker (não precisam existir dentro da imagem)
Dockerfile
.dockerignore
docker-compose*.yml

# Diversos
Homestead.json
Homestead.yaml
Thumbs.db
.DS_Store
*.log
