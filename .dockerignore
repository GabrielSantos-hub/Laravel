# Controle de versão e configuração de editores/IDEs
.git
.gitattributes
.github
.vscode
.idea
.fleet
.nova
.zed

# Variáveis de ambiente e segredos - NUNCA devem entrar na imagem
.env
.env.*

# Pode conter tokens de autenticação de pacotes privados
auth.json

# Dependências: reinstaladas dentro da imagem (composer install / npm ci)
vendor
node_modules

# Assets de build: gerados pela etapa Node do Dockerfile, não os locais
public/build
public/hot
public/storage

# Banco de dados local de desenvolvimento (SQLite)
database/*.sqlite
database/*.sqlite-journal

# Logs, cache, sessões e views compiladas localmente — são recriados
# dentro do container em runtime, não devem vir do host
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/app/public/*
storage/app/private/*
storage/pail
storage/*.key
bootstrap/cache/*.php

# Testes e ferramentas de qualidade (não necessários na imagem de produção)
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
.editorconfig
.styleci.yml

# Metadados do próprio Docker/documentação (não precisam existir dentro
# da imagem)
Dockerfile
.dockerignore
docker-compose*.yml
README.md

# Diversos
Homestead.json
Homestead.yaml
Thumbs.db
.DS_Store
*.log
